# ==============================================================================
# PrintWithQR Environment Variables Configuration Template
# ==============================================================================

# Supabase Public & Service Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-side Supabase Mirror (Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Razorpay Payment Gateway (Server & Client Public ID)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
VITE_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"

# Security Secrets & Token Signing
# CRON_SECRET: Used to authenticate scheduled Vercel Cron cleanup tasks
CRON_SECRET="generate-a-secure-random-32-byte-hex-string"

# ORDER_SESSION_SECRET: Used to HMAC sign short-lived QR customer order capability tokens
ORDER_SESSION_SECRET="generate-a-secure-random-32-byte-hex-string"

# REGISTRATION_SECRET: Used to hash IPs, device fingerprints, and phone numbers for abuse prevention
REGISTRATION_SECRET="generate-a-secure-random-32-byte-hex-string"

# REQUEST_LOG_SECRET: Used for internal authentication log hashing
REQUEST_LOG_SECRET="generate-a-secure-random-32-byte-hex-string"

# CORS & Domain Configuration
ALLOWED_ORIGIN="https://www.printwithqr.in"

# Rate Limiting & Anti-Abuse Thresholds
RATE_LIMIT_REGISTRATION_MAX_PER_IP=8
RATE_LIMIT_REGISTRATION_WINDOW_MINUTES=60
RATE_LIMIT_SUSPICIOUS_IP_MAX=4
