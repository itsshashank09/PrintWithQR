# Browser-safe Supabase configuration (these values are embedded in the client build)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=

# Server-only Vercel Function configuration (never prefix these with VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CRON_SECRET=
# Server-only scheduled Storage cleanup authorization (Vercel + Supabase Vault)
PRINT_CLEANUP_SECRET=
ORDER_SESSION_SECRET=
REGISTRATION_SECRET=
REQUEST_LOG_SECRET=
ALLOWED_ORIGIN=http://localhost:3000

# Use a test Supabase project and Razorpay test-mode keys for development.
# Populate frontend/.env.local locally or use Vercel development variables.
# Generate distinct signing secrets; never put them in VITE_* variables.
